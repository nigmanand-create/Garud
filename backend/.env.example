# Server
PORT=3000
NODE_ENV=development

# Swagger UI: http://localhost:3000/api/docs
# OpenAPI JSON: http://localhost:3000/api/docs-json

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://garud:garud@127.0.0.1:5434/garudhub?schema=public"

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Demo users (npm run prisma:seed) — see ../DEMO_ACCOUNTS.md
DEMO_PASSWORD=ChangeMeDemo123!
ADMIN_EMAIL=admin@garudhub.local
ADMIN_PASSWORD=ChangeMeDemo123!

# Local file uploads (partner application docs + listing images under listings/)
UPLOAD_DIR=./uploads
