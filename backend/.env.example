# Server
PORT=3000
NODE_ENV=development

# Production: use NODE_ENV=production, strong JWT secrets (see docs/PRODUCTION_READINESS.md).
# GARUD_DEPLOY_ENV=staging|production — live Razorpay enforced when production.
# Swagger is OFF when NODE_ENV=production unless SWAGGER_ENABLED=true (staging only).
# SWAGGER_ENABLED=true

# Swagger UI (dev): http://localhost:3000/api/docs
# OpenAPI JSON: http://localhost:3000/api/docs-json

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://garud:garud@127.0.0.1:5434/garudhub?schema=public"

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Demo users (npm run prisma:seed) — see ../DEMO_ACCOUNTS.md
DEMO_PASSWORD=ChangeMeDemo123!
ADMIN_EMAIL=admin@garudhub.local
ADMIN_PASSWORD=ChangeMeDemo123!

# Local file uploads (partner application docs + listing images under listings/)
UPLOAD_DIR=./uploads

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Transactional email (Phase 1 lead loop). Omit SMTP_HOST to log emails instead of sending.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="GarudHub <no-reply@garudhub.me>"
# ADMIN_NOTIFY_EMAIL=ops@garudhub.me          # comma-separated; new-enquiry alerts
# PUBLIC_APP_URL=https://garudhub.me          # deep links in emails

# Logging (default: json in production, pretty otherwise)
# LOG_FORMAT=json
# LOG_LEVEL=log

# Rate limits per client IP (defaults shown) — see docs/PRODUCTION_READINESS.md
# THROTTLE_GLOBAL_LIMIT=120
# THROTTLE_GLOBAL_TTL_MS=60000
# THROTTLE_AUTH_LIMIT=10
# THROTTLE_AUTH_REFRESH_LIMIT=30
# THROTTLE_ENQUIRY_LIMIT=5

# CRM webhook (enquiry.created / enquiry.routed). Set BOTH; HMAC-SHA256 signed. HTTPS required in production.
# CRM_WEBHOOK_URL=https://crm.example.com/hooks/garudhub
# CRM_WEBHOOK_SECRET=at-least-16-random-characters
# CRM_WEBHOOK_TIMEOUT_MS=5000
# CRM_WEBHOOK_MAX_ATTEMPTS=3
# CRM_WEBHOOK_RETRY_DELAY_MS=500

# DB pool tuning example (see docs/PRODUCTION_READINESS.md § Database connection pooling):
# DATABASE_URL="postgresql://garud:garud@127.0.0.1:5434/garudhub?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10"
