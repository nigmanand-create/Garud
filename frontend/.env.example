# GarudHub platform UI → NestJS API (via same-origin proxy in dev)
NEXT_PUBLIC_API_URL=/platform-api/v1

# Server-side proxy target (Next.js route handler only)
BACKEND_URL=http://127.0.0.1:3000

# Floating “Ask Garud” assistant on platform/marketing shell (set false to hide)
NEXT_PUBLIC_ASSISTANT_ENABLED=true

# --- Production / staging checklist (garudhub.me, dev.garudhub.me) ---
#
# 1. NEXT_PUBLIC_API_URL=/platform-api/v1
#    Keep same-origin proxy so JWT calls avoid CORS; tunnel points at Next :3001 only.
# 2. BACKEND_URL=http://127.0.0.1:3000
#    Loopback to Nest on the same host as Next (pm2/systemd).
# 3. Do NOT put secrets in NEXT_PUBLIC_* — only values safe for the browser bundle.
# 4. NODE_ENV=production for `next build` / `next start` on the host.
# 5. Razorpay checkout uses server-side keys in backend .env; no Razorpay secret in frontend.
# 6. Verify after deploy: marketplace load, login, enquiry form, checkout (test/live per env).
#
# See docs/PRODUCTION_READINESS.md for full P0/P1/P2 ops checklist.
# Staging smoke (before dev → main): docs/STAGING_SMOKE_CHECKLIST.md
# Release log template: deploy/RELEASE.md
# Post-deploy health: deploy/scripts/post-deploy-health-check.sh
# DB backup template: deploy/scripts/pg-backup.example.sh
