# GarudHub platform UI → NestJS API (via same-origin proxy in dev)
NEXT_PUBLIC_API_URL=/platform-api/v1

# Server-side proxy target (Next.js route handler only)
BACKEND_URL=http://127.0.0.1:3000

# Floating “Ask Garud” assistant on platform/marketing shell (set false to hide)
NEXT_PUBLIC_ASSISTANT_ENABLED=true
